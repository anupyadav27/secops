  },
  "logic": {
    "check_type": "pattern",
    "pattern": "^(?=.*(?=\\(?=(?:\\((?=[^()]+\\))|[^()]+|(?<=\\))\\))(?!\\2))(?:[^()]*\\((?=[^()]+\\))|[^()]+|(?<=\\))\\))*$",
    "new_check_type_doc": "This check type matches regular expressions containing contradictory lookahead assertions."
