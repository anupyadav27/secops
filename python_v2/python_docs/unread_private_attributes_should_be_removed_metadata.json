{
  "rule_id": "unread_private_attributes_should_be_removed",
  "title": "Unread private attributes should be removed",
  "type": "CODE_SMELL",
  "status": "ready",
  "defaultSeverity": "Minor",
  "description": "This rule checks for private attributes that are never read in the code.",
  "message": "Unread private attribute",
  "remediation": {
    "func": "Constant/Issue",
    "constantCost": "5min"
  },
  "tags": [
    "private",
    "attributes",
    "readability"
  ],
  "impact": "Readability",
  "recommendation": "Remove the unused private attribute",
  "references": [],
  "examples": {
    "noncompliant": [
      {
        "code": "class MyClass:\n    _unused_attr = 1\n    def foo(self):\n        pass",
        "description": "Private attribute _unused_attr is never read"
      }
    ],
    "compliant": [
      {
        "code": "class MyClass:\n    _attr = 1\n    def foo(self):\n        self._attr += 1",
        "description": "Private attribute _attr is read"
      }
    ]
  },
  "devsecops": {
    "category": "",
    "security": "",
    "automation": "",
    "compliance": ""
  },
  "why_is_this_an_issue": "Unused private attributes clutter the code and make it harder to understand.",
  "how_to_fix": "Remove the unused private attribute.",
  "security_mappings": {
    "CWE": "",
    "CERT": "",
    "OWASP": ""
  },
  "logic": {
    "check_type": "property_comparison",
    "property_path": [
      "node",
      "name"
    ],
    "forbidden_values": [
      "_",
      "__"
    ],
    "is_private": {
      "check_type": "property_comparison",
      "property_path": [
        "node",
        "parent",
        "name"
      ],
      "forbidden_values": [
        "self"
      ]
    },
    "is_read": {
      "check_type": "pattern",
      "pattern": "assignment",
      "property_path": [
        "node",
        "body",
        "body"
      ]
    },
    "is_unread": {
      "check_type": "not_contains",
      "property_path": [
        "node",
        "body",
        "body"
      ],
      "forbidden_values": [
        "self._<property_name>"
      ]
    }
  },
  "metadata": {
    "filename": "unread_private_attributes_should_be_removed.json",
    "rule_id": "unread_private_attributes_should_be_removed",
    "title": "Unread private attributes should be removed",
    "status": "ready",
    "defaultSeverity": "Minor"
  }
}